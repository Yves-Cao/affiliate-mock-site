{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://affiliate.local/schemas/events-v1.0.json",
  "title": "Affiliate event contract v1.0",
  "description": "D1-D10 MVP event contract. Numeric values in examples are mock references, not production defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "processed_at",
    "trace_id",
    "source",
    "rule_version",
    "idempotency_key",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "credit_point_recorded",
        "credit_score_recalculated",
        "credit_level_changed",
        "credit_override_activated",
        "credit_override_expired",
        "credit_benefit_locked",
        "cluster_suspected",
        "cluster_confirmed",
        "cluster_cleared",
        "cluster_hold_extended",
        "cluster_manual_required",
        "cluster_commission_rejected",
        "onboarding_gate_config_changed",
        "traffic_profile_review_completed",
        "official_path_library_changed",
        "target_path_violation_detected",
        "click_risk_detected",
        "event_gap_detected",
        "event_backfill_completed",
        "risk_case_group_merged",
        "risk_case_group_split",
        "baseline_deviation_detected",
        "baseline_switched",
        "investigation_required",
        "investigation_sla_escalated",
        "investigation_concluded",
        "attribution_integrity_check_completed",
        "partner_notice_issued",
        "rule_shadow_run_completed",
        "attribution_health_degraded",
        "auto_quarantine_applied",
        "auto_quarantine_released",
        "quarantine_threshold_changed",
        "data_export_requested",
        "data_deleted",
        "breach_notification_required",
        "partner_tag_applied",
        "partner_tag_removed",
        "quality_economics_snapshot_created",
        "risk_commission_link_created",
        "staging_e2e_completed",
        "staging_signoff_recorded",
        "api_contract_check_completed",
        "quarterly_audit_pack_generated",
        "asset_landing_change_detected",
        "subchannel_risk_state_changed",
        "multi_level_schema_reserved"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "affiliate",
        "crm",
        "imc",
        "payment",
        "test"
      ]
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_id": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "impact": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "admin_full",
        "partner_limited",
        "audit_only",
        "test_only"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "onboarding_gate_config_changed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "gate_enabled",
              "required_fields",
              "reason",
              "operator"
            ],
            "properties": {
              "gate_enabled": {
                "type": "boolean"
              },
              "required_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string"
              },
              "approval_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "traffic_profile_review_completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "partner_id",
              "profile_version",
              "result",
              "reason_code"
            ],
            "properties": {
              "partner_id": {
                "type": "string"
              },
              "profile_version": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected",
                  "pending_review"
                ]
              },
              "reason_code": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "official_path_library_changed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "official_path_id",
              "path_version",
              "operator",
              "effective_time"
            ],
            "properties": {
              "official_path_id": {
                "type": "string"
              },
              "path_version": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "diff": {
                "type": "object",
                "additionalProperties": true
              },
              "effective_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "target_path_violation_detected"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "target_hash",
              "policy_version",
              "action",
              "trace_id"
            ],
            "properties": {
              "target_hash": {
                "type": "string"
              },
              "official_path_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_version": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "trace_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "click_risk_detected"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "click_id",
              "risk_code",
              "rule_id",
              "rule_version",
              "parameter_version",
