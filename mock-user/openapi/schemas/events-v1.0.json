              "stage": {
                "type": "string"
              },
              "criticality": {
                "type": "string",
                "enum": [
                  "critical",
                  "secondary"
                ]
              },
              "expected_count": {
                "type": "integer",
                "minimum": 0
              },
              "actual_count": {
                "type": "integer",
                "minimum": 0
              },
              "gap_count": {
                "type": "integer",
                "minimum": 0
              },
              "blocked_settlement": {
                "type": "boolean"
              },
              "task_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "event_backfill_completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "task_id",
              "backfilled_event_ids",
              "idempotency_key",
              "recheck_result"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "backfilled_event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "idempotency_key": {
                "type": "string",
                "minLength": 1
              },
              "recheck_result": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
