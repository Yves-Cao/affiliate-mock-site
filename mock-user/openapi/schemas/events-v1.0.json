              },
              "baseline_version": {
                "type": "string"
              },
              "window": {
                "type": "object",
                "additionalProperties": true
              },
              "sample_size": {
                "type": "integer",
                "minimum": 0
              },
              "switched_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
