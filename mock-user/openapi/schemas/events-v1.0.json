                  "peer",
                  "partner"
                ]
              },
              "window": {
                "type": "object",
                "additionalProperties": true
              },
              "sample_size": {
                "type": "integer",
                "minimum": 0
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "metric": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "baseline_switched"
          }
        },
