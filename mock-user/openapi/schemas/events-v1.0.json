              "click_id": {
                "type": "string"
              },
              "risk_code": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "rule_version": {
                "type": "string"
              },
              "parameter_version": {
                "type": "string"
              },
              "evidence_id": {
                "type": "string"
              },
              "effective_click": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "event_gap_detected"
