      "then": {
        "properties": {
          "data": {
            "required": [
              "case_group_id",
              "new_group_ids",
              "operator",
              "reason"
            ],
            "properties": {
              "case_group_id": {
                "type": "string"
              },
              "new_group_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "operator": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
