{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Affiliate CX cross-cutting object schemas",
  "type": "object",
  "definitions": {
    "CxActionRequest": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": true,
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "self_review": {"type": "boolean"},
        "approval_result": {"type": "string", "enum": ["approved", "rejected", "returned"]},
        "impact_confirmation": {"type": "string"},
        "target": {"type": "string"},
        "result": {"type": "string"},
        "role": {"type": "string", "enum": ["risk", "finance", "compliance"]},
        "member_ids": {"type": "array", "items": {"type": "string"}},
        "materials_required": {"type": "array", "items": {"type": "string"}},
        "idempotency_key": {"type": "string", "minLength": 8}
      }
    },
    "TrafficProfile": {
      "type": "object",
      "required": ["partner_id", "profile_version", "status"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "profile_version": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["missing", "draft", "pending_review", "approved", "rejected"]},
        "primary_countries": {"type": "array", "items": {"type": "string"}},
        "channel_type": {"type": "string"},
        "site_or_app": {"type": "string"},
        "promotion_method": {"type": "string"},
        "expected_volume": {"type": "integer", "minimum": 0},
        "historical_platforms": {"type": "array", "items": {"type": "string"}},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "limited_explanation": {"$ref": "#/definitions/LimitedExplanation"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "TrafficProfileReview": {
      "type": "object",
      "required": ["partner_id", "profile_version", "result", "reason_code"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "profile_version": {"type": "integer", "minimum": 1},
        "result": {"type": "string", "enum": ["approved", "rejected", "returned"]},
        "reason_code": {"type": "string"},
        "reviewer": {"type": "string"},
        "effective_time": {"type": "string", "format": "date-time"},
        "approval_record": {"$ref": "./common.json#/definitions/ApprovalRecord"}
      }
    },
    "LinkEligibilityResult": {
      "type": "object",
      "required": ["partner_id", "eligible", "profile_gate_required", "blocking_reasons"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "eligible": {"type": "boolean"},
        "profile_gate_required": {"type": "boolean"},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "profile_status": {"type": "string"},
        "staging_required": {"type": "boolean"},
        "realtime_hard_risk_required": {"type": "boolean"},
        "next_action": {"type": "string"}
      }
    },
    "OnboardingGateConfig": {
      "type": "object",
      "required": ["gate_enabled", "required_fields", "scope", "reason_required", "version"],
      "additionalProperties": false,
      "properties": {
        "gate_enabled": {"type": "boolean"},
        "required_fields": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "string"},
        "reason_required": {"type": "boolean"},
        "version": {"type": "integer", "minimum": 1},
        "approval_record": {"$ref": "./common.json#/definitions/ApprovalRecord"},
        "audit_id": {"type": "string"},
        "effective_time": {"type": "string", "format": "date-time"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "OfficialDomainPolicy": {
      "type": "object",
      "required": ["official_domain", "blocked_patterns", "version"],
      "additionalProperties": false,
      "properties": {
        "official_domain": {"type": "string"},
        "blocked_patterns": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "integer", "minimum": 1},
        "approval_record": {"$ref": "./common.json#/definitions/ApprovalRecord"},
        "effective_time": {"type": "string", "format": "date-time"}
      }
    },
    "OfficialPathLibraryItem": {
      "type": "object",
      "required": ["official_path_id", "path", "page_name", "status", "version"],
      "additionalProperties": false,
      "properties": {
        "official_path_id": {"type": "string"},
        "path": {"type": "string"},
        "page_name": {"type": "string"},
        "status": {"type": "string", "enum": ["enabled", "disabled", "pending", "deprecated"]},
        "platforms": {"type": "array", "items": {"type": "string"}},
        "countries": {"type": "array", "items": {"type": "string"}},
        "channels": {"type": "array", "items": {"type": "string"}},
        "risk_level": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "effective_time": {"type": "string", "format": "date-time"}
      }
    },
    "ClickRiskRule": {
      "type": "object",
      "required": ["rule_id", "rule_version", "parameter_version", "risk_codes"],
      "additionalProperties": false,
      "properties": {
        "rule_id": {"type": "string"},
        "rule_version": {"type": "string"},
        "parameter_version": {"type": "string"},
        "risk_codes": {"type": "array", "items": {"type": "string"}},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "ClickRiskEvidence": {
      "type": "object",
      "required": ["click_id", "risk_codes", "rule_id", "rule_version", "parameter_version", "effective_click_result"],
      "additionalProperties": false,
      "properties": {
        "click_id": {"type": "string"},
        "risk_codes": {"type": "array", "items": {"type": "string"}},
        "rule_id": {"type": "string"},
        "rule_version": {"type": "string"},
        "parameter_version": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "effective_click_result": {"type": "string", "enum": ["valid", "invalid", "excluded"]},
        "attributed": {"type": "boolean"},
        "commission_counted": {"type": "boolean"},
        "trace_id": {"type": "string"}
      }
    },
    "EventIntegritySnapshot": {
      "type": "object",
      "required": ["stage", "criticality", "expected_count", "actual_count", "gap_count", "blocked_settlement"],
      "additionalProperties": false,
      "properties": {
        "stage": {"type": "string", "enum": ["click", "registration", "kyc", "deposit", "trade", "commission"]},
        "criticality": {"type": "string", "enum": ["critical", "secondary"]},
        "expected_count": {"type": "integer", "minimum": 0},
        "actual_count": {"type": "integer", "minimum": 0},
        "gap_count": {"type": "integer", "minimum": 0},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0},
        "latency_p95_seconds": {"type": "number", "minimum": 0},
        "blocked_settlement": {"type": "boolean"},
        "task_id": {"type": "string"}
      }
    },
    "AttributionIntegrityCheck": {
      "type": "object",
      "required": ["check_id", "period", "missing_attribution_count", "duplicate_attribution_count"],
      "additionalProperties": false,
      "properties": {
        "check_id": {"type": "string"},
        "period": {"type": "object", "additionalProperties": true},
        "missing_attribution_count": {"type": "integer", "minimum": 0},
        "duplicate_attribution_count": {"type": "integer", "minimum": 0},
        "task_ids": {"type": "array", "items": {"type": "string"}},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "AttributionHealthSnapshot": {
      "type": "object",
      "required": ["stage", "health_score", "previous_score", "threshold_version"],
      "additionalProperties": false,
      "properties": {
        "stage": {"type": "string"},
        "health_score": {"type": "number", "minimum": 0, "maximum": 100},
        "previous_score": {"type": "number", "minimum": 0, "maximum": 100},
        "threshold_version": {"type": "string"},
        "trend": {"type": "string", "enum": ["up", "flat", "down"]},
        "task_id": {"type": "string"}
      }
    },
    "RiskCaseGroup": {
      "type": "object",
      "required": ["case_group_id", "member_ids", "group_reason", "status", "split_status"],
      "additionalProperties": false,
      "properties": {
        "case_group_id": {"type": "string"},
        "member_ids": {"type": "array", "items": {"type": "string"}},
        "group_reason": {"type": "string"},
        "status": {"type": "string", "enum": ["auto_merged", "under_review", "confirmed", "cleared", "split"]},
        "group_conclusion": {"type": "string"},
        "impact_summary": {"type": "object", "additionalProperties": true},
        "split_status": {"type": "string", "enum": ["none", "pending", "completed"]},
        "rule_version": {"type": "string"},
        "trace_id": {"type": "string"}
      }
    },
    "RiskCaseSplitRequest": {
      "type": "object",
      "required": ["case_group_id", "member_ids", "split_reason"],
      "additionalProperties": false,
      "properties": {
        "case_group_id": {"type": "string"},
        "member_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "split_reason": {"type": "string", "minLength": 1},
        "approver_id": {"type": "string"},
        "new_case_ref": {"type": "string"}
      }
    },
    "PartnerBaseline": {
      "type": "object",
      "required": ["partner_id", "baseline_type", "window", "sample_size", "confidence", "baseline_version"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "baseline_type": {"type": "string", "enum": ["partner", "peer", "country", "channel"]},
        "window": {"type": "object", "additionalProperties": true},
        "sample_size": {"type": "integer", "minimum": 0},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "switched_at": {"type": "string", "format": "date-time"},
        "baseline_version": {"type": "string"},
        "review_priority": {"type": "string"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "BaselineWindowConfig": {
      "type": "object",
      "required": ["min_clicks", "min_registrations", "window_days"],
      "additionalProperties": false,
      "properties": {
        "min_clicks": {"type": "integer", "minimum": 1},
        "min_registrations": {"type": "integer", "minimum": 1},
        "window_days": {"type": "integer", "minimum": 1},
        "review_priority": {"type": "string"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "BaselineDeviation": {
      "type": "object",
      "required": ["partner_id", "metric", "actual", "baseline", "deviation", "confidence"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "metric": {"type": "string"},
        "actual": {"type": "number"},
        "baseline": {"type": "number"},
        "deviation": {"type": "number"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      }
    },
    "InvestigationTask": {
      "type": "object",
      "required": ["task_id", "case_group_id", "status", "link_restriction_level", "commission_calculated", "auto_settlement_blocked"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "case_group_id": {"type": "string"},
        "status": {"type": "string", "enum": ["pending", "materials_requested", "under_review", "concluded", "cancelled"]},
        "materials_required": {"type": "array", "items": {"type": "string"}},
        "due_at": {"type": "string", "format": "date-time"},
        "response_sla": {"$ref": "#/definitions/InvestigationSlaConfig"},
        "link_restriction_level": {"type": "string", "enum": ["none", "new_links", "all_links"]},
        "commission_calculated": {"type": "boolean"},
        "auto_settlement_blocked": {"type": "boolean"},
        "conclusion": {"type": "string"},
        "limited_explanation": {"$ref": "#/definitions/LimitedExplanation"}
      }
    },
    "InvestigationSlaConfig": {
      "type": "object",
      "required": ["first_response_hours", "reminder_hours", "max_duration_days", "escalation_action"],
      "additionalProperties": false,
      "properties": {
        "first_response_hours": {"type": "integer", "minimum": 1},
        "reminder_hours": {"type": "integer", "minimum": 1},
        "max_duration_days": {"type": "integer", "minimum": 1},
        "escalation_action": {"type": "string"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "QuarantineRecord": {
      "type": "object",
      "required": ["quarantine_id", "source_type", "source_ref_id", "object_type", "object_id", "reason_code", "blocked_settlement"],
      "additionalProperties": false,
      "properties": {
        "quarantine_id": {"type": "string"},
        "source_type": {"type": "string", "enum": ["investigation", "event_gap", "d_plus_n", "cluster", "cap_breaker", "manual"]},
        "source_ref_id": {"type": "string"},
        "object_type": {"type": "string"},
        "object_id": {"type": "string"},
        "reason_code": {"type": "string"},
        "blocked_settlement": {"type": "boolean"},
        "blocked_amount": {"$ref": "./common.json#/definitions/Money"},
        "blocked_since": {"type": "string", "format": "date-time"},
        "waiting_days": {"type": "number", "minimum": 0},
        "recheck_result": {"type": "string"}
      }
    },
    "QuarantineQueueConfig": {
      "type": "object",
      "required": ["d_plus_n_days", "sort_weights", "refresh_interval"],
      "additionalProperties": false,
      "properties": {
        "d_plus_n_days": {"type": "integer", "minimum": 1},
        "sort_weights": {"type": "object", "additionalProperties": {"type": "number"}},
        "refresh_interval": {"type": "string"},
        "export_policy": {"type": "string"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "StagingRun": {
      "type": "object",
      "required": ["run_id", "environment", "contract_version", "automated_result", "fund_reconciliation_diff", "gate_result"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string"},
        "environment": {"type": "string"},
        "contract_version": {"type": "string"},
        "automated_result": {"type": "string", "enum": ["passed", "failed", "running"]},
        "fund_reconciliation_diff": {"$ref": "./common.json#/definitions/Money"},
        "gate_result": {"type": "string", "enum": ["blocked", "pending_signoff", "passed"]},
        "scenario_id": {"type": "string"},
        "signoffs": {"type": "array", "items": {"$ref": "#/definitions/StagingSignoff"}}
      }
    },
    "StagingSignoff": {
      "type": "object",
      "required": ["run_id", "role", "result"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string"},
        "role": {"type": "string", "enum": ["risk", "finance", "compliance"]},
        "signoff_user": {"type": "string"},
        "result": {"type": "string", "enum": ["approved", "rejected", "returned"]},
        "comment": {"type": "string"},
        "signed_at": {"type": "string", "format": "date-time"}
      }
    },
    "RuleShadowRun": {
      "type": "object",
      "required": ["shadow_run_id", "rule_version", "dataset", "status", "hit_count"],
      "additionalProperties": false,
      "properties": {
        "shadow_run_id": {"type": "string"},
        "rule_version": {"type": "string"},
        "dataset": {"type": "string"},
        "status": {"type": "string", "enum": ["running", "completed", "failed", "cancelled"]},
        "hit_count": {"type": "integer", "minimum": 0},
        "false_positive_hint": {"type": "integer", "minimum": 0},
        "fund_impact": {"$ref": "./common.json#/definitions/Money"},
        "diffs": {"type": "array", "items": {"$ref": "#/definitions/ShadowRunDiff"}}
      }
    },
    "ShadowRunDiff": {
      "type": "object",
      "required": ["object_id", "live_result", "shadow_result"],
      "additionalProperties": false,
      "properties": {
        "object_id": {"type": "string"},
        "live_result": {"type": "string"},
        "shadow_result": {"type": "string"},
        "fund_impact": {"$ref": "./common.json#/definitions/Money"},
        "false_positive_hint": {"type": "boolean"}
      }
    },
    "PartnerOperationTag": {
      "type": "object",
      "required": ["tag_id", "partner_id", "tag_type", "value"],
      "additionalProperties": false,
      "properties": {
        "tag_id": {"type": "string"},
        "partner_id": {"type": "string"},
        "tag_type": {"type": "string"},
        "value": {"type": "string"},
        "operator": {"type": "string"},
        "audit_id": {"type": "string"}
      }
    },
    "DataGovernancePolicy": {
      "type": "object",
      "required": ["policy_id", "data_type", "retention_days", "export_scope", "deletion_rule", "notification_sla"],
      "additionalProperties": false,
      "properties": {
        "policy_id": {"type": "string"},
        "data_type": {"type": "string"},
        "retention_days": {"type": "integer", "minimum": 1},
        "export_scope": {"type": "array", "items": {"type": "string"}},
        "deletion_rule": {"type": "string"},
        "notification_sla": {"type": "string"},
        "reference_ranges": {"type": "array", "items": {"$ref": "./common.json#/definitions/ReferenceRange"}}
      }
    },
    "DataBreachIncident": {
      "type": "object",
      "required": ["incident_id", "severity", "detected_at", "notification_due_at", "owner"],
      "additionalProperties": false,
      "properties": {
        "incident_id": {"type": "string"},
        "severity": {"type": "string"},
        "detected_at": {"type": "string", "format": "date-time"},
        "notification_due_at": {"type": "string", "format": "date-time"},
        "owner": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "QualityEconomicsSnapshot": {
      "type": "object",
      "required": ["partner_id", "period", "commission", "loss", "quality_metrics", "snapshot_version"],
      "additionalProperties": false,
      "properties": {
        "partner_id": {"type": "string"},
        "period": {"type": "string"},
        "commission": {"$ref": "./common.json#/definitions/Money"},
        "loss": {"$ref": "./common.json#/definitions/Money"},
        "quality_metrics": {"type": "object", "additionalProperties": true},
        "snapshot_version": {"type": "string"},
        "p1_extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "RiskCommissionLink": {
      "type": "object",
      "required": ["case_group_id", "commission_case_id", "link_type", "trace_id"],
      "additionalProperties": false,
      "properties": {
        "case_group_id": {"type": "string"},
        "commission_case_id": {"type": "string"},
        "link_type": {"type": "string"},
        "trace_id": {"type": "string"},
        "amount": {"$ref": "./common.json#/definitions/Money"},
        "hold_status": {"type": "string"},
        "guarantee_status": {"type": "string"}
      }
    },
    "LimitedExplanation": {
      "type": "object",
      "required": ["category", "impact_scope", "evidence_scope", "next_step", "appeal_path"],
      "additionalProperties": false,
      "properties": {
        "category": {"type": "string"},
        "impact_scope": {"type": "string"},
        "time_scope": {"type": "string"},
        "evidence_scope": {"type": "string"},
        "next_step": {"type": "string"},
        "appeal_path": {"type": "string"},
        "trace_id": {"type": "string"}
      }
    },
    "ContractQualityCheck": {
      "type": "object",
      "required": ["contract_version", "check_result", "openapi", "event_schema", "mock_server", "docs"],
      "additionalProperties": false,
      "properties": {
        "contract_version": {"type": "string"},
        "check_result": {"type": "string", "enum": ["passed", "failed"]},
        "openapi": {"type": "string", "enum": ["passed", "failed"]},
        "event_schema": {"type": "string", "enum": ["passed", "failed"]},
        "mock_server": {"type": "string", "enum": ["passed", "failed"]},
        "docs": {"type": "string", "enum": ["passed", "failed"]},
        "error_sample": {"type": "array", "items": {"type": "string"}}
      }
    },
    "QuarterlyAuditPack": {
      "type": "object",
      "required": ["pack_id", "period", "status", "reserved_only"],
      "additionalProperties": false,
      "properties": {
        "pack_id": {"type": "string"},
        "period": {"type": "string"},
        "status": {"type": "string"},
        "reserved_only": {"type": "boolean"}
      }
    },
    "AssetLandingPatrolTask": {
      "type": "object",
      "required": ["task_id", "asset_id", "status", "reserved_only"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string"},
        "asset_id": {"type": "string"},
        "status": {"type": "string"},
        "reserved_only": {"type": "boolean"}
      }
    },
    "SubChannelRiskState": {
      "type": "object",
      "required": ["subchannel_id", "status", "reason_code", "link_effect", "reserved_only"],
      "additionalProperties": false,
      "properties": {
        "subchannel_id": {"type": "string"},
        "status": {"type": "string"},
        "reason_code": {"type": "string"},
        "link_effect": {"type": "string"},
        "review_task": {"type": "string"},
        "reserved_only": {"type": "boolean"}
      }
    },
    "MultiLevelSchemaReserve": {
      "type": "object",
      "required": ["parent_partner_id", "hierarchy_path", "reserved_only", "enabled"],
      "additionalProperties": false,
      "properties": {
        "parent_partner_id": {"type": "string"},
        "hierarchy_path": {"type": "array", "items": {"type": "string"}},
        "reserved_only": {"type": "boolean"},
        "enabled": {"type": "boolean"}
      }
    },
    "AdvancedTierPricing": {
      "type": "object",
      "required": ["schema_version", "reserved_only", "enabled"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "string"},
        "reserved_only": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "trigger_condition": {"type": "string"}
      }
    }
  }
}
